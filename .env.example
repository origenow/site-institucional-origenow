# Variáveis de ambiente do site da Origenow.
# Copie para .env (que NÃO vai para o git) em desenvolvimento, e configure as
# mesmas na aba Variables do serviço na Railway em produção.

# Slack — escolha UMA das duas formas:
# (A, recomendada) Incoming Webhook do canal #comercial — não expira, isolado.
SLACK_WEBHOOK_URL=
# (B) Reaproveitar o app Slack dos agentes via bot token + ID do canal.
#     CUIDADO: se o app tiver rotação de token ligada (claude-agency tem), o
#     xoxb expira em ~12h e as notificações param. Só use se a rotação estiver
#     desligada para esse app. #comercial = C089RSN323C.
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=C089RSN323C

# E-mail (SMTP do Zoho) — destino e credenciais do lead
LEAD_EMAIL_TO=contato@origenow.com.br
SMTP_USER=contato@origenow.com.br
SMTP_PASS=                 # senha de aplicativo do Zoho (não a senha da conta)
# Opcionais (defaults já apontam para o Zoho):
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465

# Google — tags e conversões (IDs públicos, opcionais). Lidos no BUILD: na
# Railway, alterar um deles gera novo deploy. Também podem ficar versionados
# em build/tracking.js (PADRAO); a variável de ambiente tem precedência.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# GOOGLE_ADS_ID=AW-XXXXXXXXXX
# GOOGLE_ADS_LEAD_LABEL=         # rótulo da conversão "lead enviado"
# GOOGLE_ADS_CONTACT_LABEL=      # rótulo da conversão "clique no WhatsApp"
# GTM_ID=GTM-XXXXXXX             # alternativa ao gtag direto
# GOOGLE_SITE_VERIFICATION=      # meta do Search Console (se não usar TXT no DNS)

# PORT — NÃO definir na Railway (ela injeta). Local usa 3000 por padrão.
# PORT=3000
