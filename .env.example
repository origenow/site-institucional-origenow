# Variáveis de ambiente do site da Origenow.
# Copie para .env (que NÃO vai para o git) em desenvolvimento, e configure as
# mesmas na aba Variables do serviço na Railway em produção.

# Slack — Incoming Webhook do canal #comercial
SLACK_WEBHOOK_URL=

# E-mail (SMTP do Zoho) — destino e credenciais do lead
LEAD_EMAIL_TO=contato@origenow.com.br
SMTP_USER=contato@origenow.com.br
SMTP_PASS=                 # senha de aplicativo do Zoho (não a senha da conta)
# Opcionais (defaults já apontam para o Zoho):
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465

# PORT — NÃO definir na Railway (ela injeta). Local usa 3000 por padrão.
# PORT=3000
